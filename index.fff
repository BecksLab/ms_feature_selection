\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/multi_panel_pca_stability.png}}

}

\caption{\label{fig-stab_pca}A vibe but don't know where it belongs -
supp mat and it beautifully mirrors the conceptual figure in the intro -
just saying.}

\end{figure}
