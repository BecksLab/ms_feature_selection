\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/conceptual.png}}

}

\caption{\label{fig-conceptual}Conceptual framework linking
multidimensional network structure (S) to multidimensional ecological
stability (Ω). Structural variation is organised along a small number of
axes (Panel B), while stability comprises multiple components (Panel A).
Each stability component depends on a different projection of structural
space (Panel C), generating process-dependent relationships and
trade-offs among stability outcomes.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/cluster_dendrogram.png}}

}

\caption{\label{fig-cluster}Hierarchical clustering of food-web
structural descriptors. Dendrogram illustrating the modular organisation
of structural metrics based on a signed correlation matrix. Clustering
was performed using UPGMA. Coloured bars indicate the seven distinct
modules, reflecting robust association patterns among metrics. The
horizontal axis represents the correlation distance (1−r), where shorter
branches indicate stronger associations between descriptors.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/cluster_dendrogram_nullNetworks.png}}

}

\caption{\label{fig-module}\emph{Figure SX:} Hierarchical clustering of
food-web structural descriptors for connectance and degree constrained
models. Dendrograms illustrate the modular organisation of structural
metrics based on a signed correlation matrix. Clustering was performed
using UPGMA. Grey bars indicate identified clusters. The horizontal axis
represents the correlation distance (1−r), where shorter branches
indicate stronger associations between descriptors. Colours of the
labels indicate the corresponding module as identified from the
empirical data. ARI i shown in the right hand side of the panel and
indicates cluster agreement with empirical clusters. Note that some
modules (particularly for the degree constrained networks) still cluster
together however others do not - this suggests that the modules are
independent and suggest that they are not constrained by link-level
processes but may reflect other emerging forms of ecological
constraints.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/modules.png}}

}

\caption{\label{fig-module}Ecological network structure emerges through
hierarchical constraints on assembly. Food web architecture can be
decomposed into six structural modules organised across three levels of
constraint. Combinatorial scaling defines the space of possible
interactions as a function of system size. This baseline gives rise to
statistical organisation, where degree constraints generate
heterogeneity in species roles and regulatory structure (trophic role
asymmetry, control heterogeneity). At the highest level, ecological
structuring imposes trophic ordering, energy flow constraints, and the
emergence of resource and control hubs (trophic integration, energy
transport, flow control).}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/pca_loadings.png}}

}

\caption{\label{fig-pca}PCA loadings plot illustrating the dominant
gradients of food web variation. Each point denotes a structural metric,
with colours corresponding to the modular groupings. The clustering of
like-coloured points along specific PC axes demonstrates that the
modular organisation is preserved within a reduced dimensional space.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/module_alignment_heatmap.png}}

}

\caption{\label{fig-alignment_heatmap}Heatmap showing the correspondence
between the seven identified food-web modules (rows) and the principal
components (columns) capturing 80\% of cumulative variance. High values
(darker shading) indicate strong alignment, where a specific module's
internal structure drives the variation captured by that PC.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/pca_loadings_heatmap.png}}

}

\caption{\label{fig-pca_heatmap}\emph{Figure SX.}}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/variance_explained.png}}

}

\caption{\label{fig-variance}\emph{Figure SX.} This figure quantifies
the relative contribution of each structural module to the variance
captured by individual Principal Components (PCs). Calculation: For each
PC, the total variance (eigenvalue) is partitioned among the k=7 modules
identified in the hierarchical clustering. The contribution of a module
to a specific PC is calculated as the sum of the squared loadings of all
metrics belonging to that module, normalised by the total variance
explained by that PC. Visual Interpretation: The alluvial plot
illustrates how the ecological weight shifts across different structural
dimensions. For example, while PC1 may be dominated by a single module,
subsequent PCs often represent a more diverse blend of modular
contributions, reflecting the multifaceted nature of topological
complexity and trophic organisation. Significance: This visualisation
confirms that the PC axes are not merely statistical artifacts but are
grounded in the specific groups of correlated metrics defined in the
main text. The stability of the flow across the first several components
demonstrates that the modular organisation of food web architecture is
consistently represented across the primary gradients of structural
variation.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/heatmap_zscores.png}}

}

\caption{\label{fig-alignment_signif}Heatmap showing module--principal
component alignment quantified by permutation-derived Z-scores. Colour
intensity reflects the magnitude and direction of alignment, and
asterisks denote cells that meet joint significance criteria
(permutation P \textless{} 0.05 and \textbar Z\textbar{} \textgreater{}
1.96). Rows correspond to structural metric modules and columns to
principal components. Clustering highlights patterns of shared alignment
across modules and multivariate structural gradients.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/fig_dimensional_reduction.png}}

}

\caption{\label{fig-dim_red}\emph{Figure SX.} Characterisation of
alternative dimensional-reduction approaches for network structural
metrics. (A) Proportion of total variance in the full metric space
retained by each representation: cluster medoids, PC-dominant metrics,
and retained PC scores (≥80\% cumulative variance). (B) Mean absolute
pairwise correlation (\textbar r\textbar) among predictors within each
representation, quantifying internal redundancy. (C) Effective
dimensionality, defined as the number of axes required to explain 80\%
of variance within each reduced predictor set. Together, these
diagnostics illustrate differences in information retention, redundancy,
and structural alignment among dimensional-reduction strategies.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/stability_variance.png}}

}

\caption{\label{fig-stab_var}Contribution of structural modules to
ecosystem stability. Bars show the absolute variance in each stability
metric explained by different structural modules, as estimated via
elastic net regression. Facets correspond to the four stability metrics:
Resistance (robustness, \(R_{50}\)), Recovery/Persistence (resilience
AUC), Stability Potential (Spectral Radius (ρ)), and Controllability
(Structural Controllability). Variance contributions are scaled by the
cross-validated \(R^2\) of the corresponding model, allowing comparison
across metrics. Differences in bar heights across facets indicate which
modules are more influential for particular stability processes.}

\end{figure}
\efloatseparator
 
\begin{figure}

\centering{

\pandocbounded{\includegraphics[keepaspectratio]{figures/stability_estimate.png}}

}

\caption{\label{fig-stab_corr}Standardised elastic net regression
coefficients linking structural predictors to ecosystem stability
metrics: Resistance (robustness, \(R_{50}\)), Recovery/Persistence
(resilience AUC), Stability Potential (Spectral Radius (ρ)), and
Controllability (Structural Controllability). Each point represents a
predictor, with vertical lines extending from zero to the coefficient
value. Coefficients are coloured by structural module and faceted by
both network representation (Cluster Dominant, PC Dominant, PCA Axis, or
Univariate) and stability metric. Positive coefficients indicate that
higher values of the predictor increase the stability metric, while
negative coefficients indicate a suppressive effect. Variation in
coefficients across facets reveals switching of structural predictors'
influence on different stability outcomes.}

\end{figure}
